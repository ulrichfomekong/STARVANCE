{
  "name": "soscope-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace soscope",
    "dev:api": "python backend/backend_api.py",
    "build": "npm run build --workspace soscope",
    "preview": "npm run preview --workspace soscope",
    "format": "npm run format --workspace soscope",
    "test:backend": "python -m unittest discover -s backend/tests -t backend -v"
  }
}
